# AI Study Plan 
# Set to false to use Gemini. true = heuristic/mock (no API key needed).
STUDY_PLAN_AI_MOCK=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

#OpenAI (AI module foundation) 
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Ask AI / assistant RAG (providers; Ollama optional)
# Leave OLLAMA_URL empty to skip local LLM and use OpenAI / extractive fallback
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=60000
OPENAI_ASSISTANT_TIMEOUT_MS=30000
ASSISTANT_EMBEDDING_MODEL=Xenova/multilingual-e5-small
TRANSFORMERS_CACHE=D:/ollama/hf-cache
ASSISTANT_INDEX_ENABLED=true
ASSISTANT_INDEX_INTERVAL_MS=30000

# Vocabulary flashcards: local pronunciation. No external TTS API.
# macOS: brew install espeak-ng
# Windows: install eSpeak NG, then put it on PATH or set the full path below.
ESPEAK_BIN=espeak-ng
ESPEAK_VOICE=en-us
# Optional origin for card image and audio URLs. Defaults to this server's host.
# PUBLIC_BASE_URL=http://localhost:5000

# Study group task alerts (hourly job)
GROUP_TASK_ALERTS_ENABLED=true
GROUP_TASK_ALERT_TIMEZONE=Asia/Ho_Chi_Minh

# Default admin (seeded on server boot if missing)
# Required in production. In development it falls back to a weak default.
ADMIN_EMAIL=admin@loopi.com
ADMIN_PASSWORD=

# Group video calls (LiveKit)
# Dev: a LiveKit Cloud project, or ws://localhost:7880 with `livekit-server --dev` (key devkey / secret secret)
# Prod: wss://rtc.<your-domain>
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Max people in one group call
CALL_MAX_PARTICIPANTS=25
# How long a call token stays valid (e.g. 2h, 90m)
CALL_TOKEN_TTL=2h
# Server-wide limits for new calls (empty = no limit). Over the limit, a group without a
# running call goes to the fallback server, then to Google Meet. Set from the load test.
CALL_MAX_ROOMS=
CALL_MAX_TOTAL_PARTICIPANTS=

# Optional second LiveKit server (e.g. a LiveKit Cloud project), used automatically when
# the main one is down or over the limits above.
LIVEKIT_FALLBACK_URL=
LIVEKIT_FALLBACK_API_KEY=
LIVEKIT_FALLBACK_API_SECRET=

# Google Meet fallback: lets the backend create Meet links (scripts/google-meet-auth.js).
# Without these, members can still use the group's standing link or paste one.
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REFRESH_TOKEN=
