# AI Study Plan 
# Set to false to use Gemini. true = heuristic/mock (no API key needed).
STUDY_PLAN_AI_MOCK=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

#OpenAI (AI module foundation) 
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Ask AI / assistant RAG (providers; Ollama optional)
# Leave OLLAMA_URL empty to skip local LLM and use OpenAI / extractive fallback
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=60000
OPENAI_ASSISTANT_TIMEOUT_MS=30000
ASSISTANT_EMBEDDING_MODEL=Xenova/multilingual-e5-small
TRANSFORMERS_CACHE=D:/ollama/hf-cache
ASSISTANT_INDEX_ENABLED=true
ASSISTANT_INDEX_INTERVAL_MS=30000

# Study group task alerts (hourly job)
GROUP_TASK_ALERTS_ENABLED=true
GROUP_TASK_ALERT_TIMEZONE=Asia/Ho_Chi_Minh

# Default admin (seeded on server boot if missing)
# Required in production. In development it falls back to a weak default.
ADMIN_EMAIL=admin@loopi.com
ADMIN_PASSWORD=
