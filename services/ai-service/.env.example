# Loopi Study AI service. Every setting is described in API.md.
PORT=5100

# Required. Must match AI_SERVICE_KEY in the backend's .env.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_SERVICE_KEY=

LOG_LEVEL=info

# Embeddings (used from phase 2)
EMBEDDING_MODEL=Xenova/multilingual-e5-small
TRANSFORMERS_CACHE=./.hf-cache
EMBEDDING_PRELOAD=true

# Ollama. Leave OLLAMA_URL empty to turn it off.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=30m
# Queue (phase 5)
OLLAMA_CONCURRENCY=1
OLLAMA_MAX_QUEUE=3

# OpenAI. Leave OPENAI_API_KEY empty to turn it off.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
