{
  "name": "loopistudy-backend",
  "version": "1.0.0",
  "description": "Backend for Loopi Study - Learning Management System",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:watch": "jest --watch",
    "db:migrate": "node src/migrations/run.js",
    "db:seed": "node src/seeders/run.js",
    "db:seed:demo": "node src/seeders/demoDataSeeder.js",
    "db:seed:milestones": "node src/seeders/milestoneSeeder.js",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "db:reset:demo": "npm run db:migrate && npm run db:seed && npm run db:seed:demo",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "keywords": [
    "lms",
    "learning",
    "study",
    "education"
  ],
  "author": "Your Team",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.5",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.9.7",
    "openai": "^6.42.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
